{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriSSH",
  "version": "0.1.0",
  "identifier": "com.szzz666.taurissh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TauriSSH",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "跨平台 SSH 工作台",
    "longDescription": "TauriSSH 是基于 Tauri 与 Ant Design 的跨平台 SSH 工作台，提供终端、SFTP 文件管理、Screen 后台会话与资源监控。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
